{
 "automation.climate_home_set_bedtime_temp": {
  "actions": [
   {
    "alias": "Stop while emergency mode is active",
    "if": [
     {
      "condition": "state",
      "entity_id": "binary_sensor.home_emergency_active",
      "state": "on"
     }
    ],
    "then": [
     {
      "alias": "Stop because emergency mode owns home state",
      "stop": "Emergency mode is active; normal automation control is paused."
     }
    ]
   },
   {
    "alias": "Set thermostats in parallel",
    "parallel": [
     {
      "action": "climate.set_temperature",
      "alias": "Set thermostat temperature - Downstairs Ecobee Thermostat",
      "data": {
       "hvac_mode": "heat_cool",
       "target_temp_high": 73,
       "target_temp_low": 67
      },
      "target": {
       "entity_id": [
        "climate.downstairs_ecobee_thermostat"
       ]
      }
     },
     {
      "action": "climate.set_temperature",
      "alias": "Set thermostat temperature - Upstairs Ecobee Thermostat",
      "data": {
       "hvac_mode": "heat_cool",
       "target_temp_high": 74,
       "target_temp_low": 67
      },
      "target": {
       "entity_id": [
        "climate.upstairs_ecobee_thermostat"
       ]
      }
     }
    ]
   }
  ],
  "alias": "Climate - Home - Set Bedtime Temp",
  "conditions": [
   {
    "condition": "or",
    "conditions": [
     {
      "condition": "state",
      "entity_id": "person.mark",
      "state": "home"
     },
     {
      "condition": "state",
      "entity_id": "person.anna",
      "state": "home"
     }
    ]
   },
   {
    "condition": "state",
    "entity_id": "input_boolean.manual_ac",
    "state": [
     "off"
    ]
   }
  ],
  "description": "Sets both Ecobee thermostats to bedtime heat/cool targets at 9:30 PM when Mark or Anna is home and Manual AC is off. This is a scheduled comfort adjustment separate from Good Night, Leaving, Arriving, and Alarm climate actions. Both thermostat service calls run in parallel.",
  "id": "1751933269418",
  "mode": "single",
  "triggers": [
   {
    "alias": "Trigger - Time reaches 21:30:00",
    "at": "21:30:00",
    "id": "time_reaches_21_30_00",
    "trigger": "time"
   }
  ]
 },
 "automation.lighting_front_yard_holiday_schedule": {
  "actions": [
   {
    "alias": "Choose the matching automation branch",
    "choose": [
     {
      "alias": "Branch - Trigger is holiday_on",
      "conditions": [
       {
        "condition": "trigger",
        "id": "holiday_on"
       }
      ],
      "sequence": [
       {
        "alias": "Christmas",
        "if": [
         {
          "condition": "state",
          "entity_id": "sensor.us_holidays",
          "state": "Christmas"
         }
        ],
        "then": [
         {
          "action": "select.select_option",
          "alias": "Select option - 2 entities",
          "data": {
           "option": "Christmas"
          },
          "target": {
           "entity_id": [
            "select.outdoor_permanent_lights_playlist",
            "select.path_lights_playlist"
           ]
          }
         },
         {
          "action": "script.turn_on",
          "alias": "Turn script on - Christmas Lights",
          "data": {},
          "target": {
           "entity_id": "script.christmas_lights"
          }
         }
        ]
       },
       {
        "alias": "Halloween",
        "if": [
         {
          "condition": "state",
          "entity_id": "sensor.us_holidays",
          "state": "Halloween"
         }
        ],
        "then": [
         {
          "action": "select.select_option",
          "alias": "Select option - 2 entities",
          "data": {
           "option": "Halloween"
          },
          "target": {
           "entity_id": [
            "select.outdoor_permanent_lights_playlist",
            "select.path_lights_playlist"
           ]
          }
         },
         {
          "action": "script.turn_on",
          "alias": "Turn script on - Halloween Lights",
          "data": {},
          "target": {
           "entity_id": [
            "script.halloween_lights"
           ]
          }
         }
        ]
       },
       {
        "alias": "July 4th",
        "if": [
         {
          "condition": "state",
          "entity_id": "sensor.us_holidays",
          "state": "Independence Day"
         }
        ],
        "then": [
         {
          "action": "select.select_option",
          "alias": "Select option - Outdoor Permanent Lights Playlist",
          "data": {
           "option": "July 4th"
          },
          "target": {
           "entity_id": "select.outdoor_permanent_lights_playlist"
          }
         },
         {
          "action": "select.select_option",
          "alias": "Select option - Path Lights Playlist",
          "data": {
           "option": "July 4th"
          },
          "target": {
           "entity_id": "select.path_lights_playlist"
          }
         },
         {
          "action": "script.turn_on",
          "alias": "Turn script on - July 4Th",
          "data": {},
          "target": {
           "entity_id": "script.july_4th"
          }
         }
        ]
       }
      ]
     },
     {
      "alias": "Branch - Trigger is holiday_off",
      "conditions": [
       {
        "condition": "trigger",
        "id": "holiday_off"
       },
       {
        "condition": "state",
        "entity_id": "sensor.us_holidays",
        "state": [
         "Christmas",
         "Halloween",
         "Independence Day"
        ]
       }
      ],
      "sequence": [
       {
        "action": "script.turn_off",
        "alias": "Turn script off - 3 entities",
        "data": {},
        "metadata": {},
        "target": {
         "entity_id": [
          "script.christmas_lights",
          "script.halloween_lights",
          "script.july_4th"
         ]
        }
       },
       {
        "action": "select.select_option",
        "alias": "Select option - 2 entities",
        "data": {
         "option": "Year Round"
        },
        "target": {
         "entity_id": [
          "select.outdoor_permanent_lights_preset",
          "select.path_lights_preset"
         ]
        }
       }
      ]
     }
    ]
   }
  ],
  "alias": "Lighting - Front Yard - Holiday Schedule",
  "conditions": [],
  "description": "Starts holiday-specific outdoor lighting before sunset and stops/resets holiday lighting at 9:59 PM when a supported holiday is active.",
  "id": "merged_front_yard_holiday_lighting_schedule",
  "mode": "single",
  "triggers": [
   {
    "alias": "Trigger - Holiday On",
    "event": "sunset",
    "id": "holiday_on",
    "offset": "-00:14:00",
    "trigger": "sun"
   },
   {
    "alias": "Trigger - Holiday Off",
    "at": "21:59:00",
    "id": "holiday_off",
    "trigger": "time"
   }
  ]
 },
