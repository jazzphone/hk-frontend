  "alias": "Lighting - Front Yard - Scheduled Exterior Lights",
  "conditions": [],
  "description": "Owns the front-yard scheduled exterior lighting windows: sunset on, 10 PM off/reset, pre-sunrise on, and post-sunrise off/reset. Deck Permanent Lights are reset/off only when the back door is locked so the Deck automation can own them during active deck use.",
  "id": "merged_front_yard_scheduled_exterior_lights",
  "mode": "single",
  "triggers": [
   {
    "alias": "Trigger - Sunset On",
    "event": "sunset",
    "id": "sunset_on",
    "offset": "-00:15:00",
    "trigger": "sun"
   },
   {
    "alias": "Trigger - Sunset Off",
    "at": "22:00:00",
    "id": "sunset_off",
    "trigger": "time"
   },
   {
    "alias": "Trigger - Sunrise On",
    "enabled": true,
    "event": "sunrise",
    "id": "sunrise_on",
    "offset": "-01:00:00",
    "trigger": "sun"
   },
   {
    "alias": "Trigger - Sunrise Off",
    "event": "sunrise",
    "id": "sunrise_off",
    "offset": "+00:30:00",
    "trigger": "sun"
   }
  ]
 },
 "automation.lighting_home_interior_sunset_lights": {
  "actions": [
   {
    "alias": "Stop while emergency mode is active",
    "if": [
     {
      "condition": "state",
      "entity_id": "binary_sensor.home_emergency_active",
      "state": "on"
     }
    ],
    "then": [
     {
      "alias": "Stop because emergency mode owns home state",
      "stop": "Emergency mode is active; normal automation control is paused."
     }
    ]
   },
   {
    "alias": "Wait briefly after Home Assistant startup",
    "if": [
     {
      "condition": "trigger",
      "id": "ha_start"
     }
    ],
    "then": [
     {
      "alias": "Wait 60 seconds",
      "delay": {
       "minutes": 1
      }
     }
    ]
   },
   {
    "alias": "Run grouped actions in parallel",
    "parallel": [
     {
      "alias": "Shared arrival lights - only when an arrival routine is not doing it",
      "if": [
       {
        "alias": "Not triggered by an arrival button",
        "condition": "not",
        "conditions": [
         {
          "condition": "trigger",
          "id": "arrival_helper"
         }
        ]
       }
      ],
      "then": [
       {
        "action": "light.turn_on",
        "alias": "Turn light on - Cabinet Lights at 100%",
        "data": {
         "brightness_pct": 100
        },
        "target": {
         "entity_id": [
          "light.cabinet_lights"
         ]
        }
       },
       {
        "action": "light.turn_on",
        "alias": "Turn light on - Living Room Lamp Light",
        "data": {
         "brightness_pct": 100
        },
        "target": {
         "entity_id": "light.living_room_lamp_light"
        }
       },
       {
        "action": "light.turn_on",
        "alias": "Turn light on - Loft Lamp",
        "data": {
         "brightness_pct": 50
        },
        "target": {
         "entity_id": [
          "light.loft_lamp"
         ]
        }
       }
      ]
     },
     {
      "action": "light.turn_on",
      "alias": "Turn light on - Foyer Chandelier",
      "data": {},
      "target": {
       "entity_id": [
        "light.foyer_chandelier"
       ]
      }
     },
     {
      "action": "light.turn_on",
      "alias": "Turn light on - Living Room Light at 100%",
      "data": {
       "brightness_pct": 100
      },
      "target": {
       "entity_id": [
        "light.living_room_light"
       ]
      }
     }
    ]
   }
  ],
  "alias": "Lighting - Home - Interior Sunset Lights",
  "conditions": [
   {
    "condition": "state",
    "entity_id": "input_boolean.disable_automation",
    "state": "off"
   },
   {
    "alias": "Condition - Someone is home or guest mode is on",
    "condition": "or",
    "conditions": [
     {
      "condition": "state",
      "entity_id": "person.mark",
      "state": "home"
     },
     {
      "condition": "state",
      "entity_id": "person.anna",
      "state": "home"
     },
     {
      "condition": "state",
      "entity_id": "person.emma",
      "state": "home"
     },
     {
      "condition": "state",
      "entity_id": "input_boolean.guest_mode",
      "state": "on"
     }
    ]
   },
   {
    "after": "sunset",
    "after_offset": "-01:00:00",
    "alias": "Condition - Evening window has started",
    "condition": "sun"
   },
   {
    "alias": "Condition - Before 10 PM",
    "before": "22:00:00",
    "condition": "time"
   },
   {
    "alias": "Condition - Night timer is idle",
    "condition": "state",
    "entity_id": "timer.night_timer",
    "state": "idle"
   }
  ],
  "description": "Turns on the configured interior evening lights one hour before sunset when someone is home, and catches up when someone arrives after the sunset-offset trigger has already passed. The Living Room overhead light is intentionally included so the Living Room no-motion timer can hold the evening scene. Catch-up triggers are limited to before 10 PM so late-night arrivals do not turn on the evening lights.",
  "id": "1750613892564",
  "mode": "restart",
  "triggers": [
   {
    "alias": "Trigger - One hour before sunset",
    "event": "sunset",
    "id": "sunset_offset",
    "offset": "-01:00:00",
    "trigger": "sun"
   },
   {
    "alias": "Trigger - Mark arrives home",
    "entity_id": "person.mark",
    "id": "arrival",
    "to": "home",
    "trigger": "state"
   },
   {
    "alias": "Trigger - Anna arrives home",
    "entity_id": "person.anna",
    "id": "arrival",
    "to": "home",
    "trigger": "state"
   },
   {
    "alias": "Trigger - Emma arrives home",
    "entity_id": "person.emma",
    "id": "arrival",
    "to": "home",
    "trigger": "state"
   },
   {
    "alias": "Trigger - Guest mode turns on",
    "entity_id": "input_boolean.guest_mode",
    "id": "guest_mode_on",
    "to": "on",
    "trigger": "state"
   },
   {
    "alias": "Trigger - Arriving helper pressed",
    "entity_id": "input_button.arriving",
    "id": "arrival_helper",
    "trigger": "state"
   },
   {
    "alias": "Trigger - Arriving Front Door helper pressed",
    "entity_id": "input_button.arriving_front_door",
    "id": "arrival_helper",
    "trigger": "state"
   },
   {
    "alias": "Trigger - Home Assistant started",
    "event": "start",
    "id": "ha_start",
    "trigger": "homeassistant"
   }
  ]
 }
}